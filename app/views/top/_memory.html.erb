<%# メインパネル全体。フォルダ/メモの一覧と、新規作成・選択モードのボタン類をまとめた箱(top.jsが開閉を担当) %>
<div id="main_panel">
  <div id="main_panel_inner">
    <%# 「+」ボタンと、そこから開く「メモ or フォルダ」選択メニュー(top.js・folder_saving.js・memo_saving.jsが担当) %>
    <div class="add_menu_wrapper">
      <button id="add_btn">+</button>
      <ul id="memo_select" class="memo_select">
        <li class="new_items">メモ</li>
        <li class="or_item">or</li>
        <li class="new_items">フォルダ</li>
      </ul>
    </div>

    <%# 選択モードのON/OFFを切り替える、手のひらアイコンのボタン(select.jsが担当) %>
    <div class="select_menu_wrapper">
      <button id="select_btn">
        <span class="material-symbols-outlined checklist">pan_tool</span>
      </button>
    </div>

    <%# メインパネルのフォルダ/メモアイコンが並ぶ置き場(top.js・show_panel.js・select.jsがクリックを監視) %>
    <div class="icon-container" id="icon_container">

      <%# ルート直下(どのフォルダにも属さない)のフォルダを、DBから取ってきて1個ずつアイコンとして表示 %>
      <% @folders.each do |folder| %>
      <div class="folder-icon" data-folder-id="<%= folder.id =%>">
        <span class="material-symbols-outlined color-blue">folder</span>
        <span class="folder-name"><%= folder.name.presence || "フォルダ名未設定" %></span>
      </div>
      <% end %>

      <%# ルート直下のメモを、同じくDBから取ってきて1個ずつアイコンとして表示 %>
      <% @memos.each do |memo| %>
      <div class="folder-icon" data-memo-id="<%= memo.id %>">
        <span class="material-symbols-outlined color-blue">description</span>
        <span class="folder-name"><%= memo.title.presence || "名称未設定メモ" %></span>
      </div>
      <% end %>
    </div>
  </div>

<%# 選択モード中に画面下に表示される、「移動/コピー/削除/共有」のアクションバー(select.jsが担当) %>
<div id="action_bar">
    <span class="material-symbols-outlined" id="move_btn">drive_file_move</span>
    <span class="material-symbols-outlined" id="copy_btn">content_copy</span>
    <span class="material-symbols-outlined" id="delete_btn">delete</span>
    <span class="material-symbols-outlined" id="share_btn">share</span>
  </div>
</div>


<%# フォルダを開くたびに右に増えていく「カラム」の入れ物。中身は最初は空で、folder_columns.jsがJSで動的に追加していく %>
<div id="folder_columns_container">
</div>


<%# メモの画面(新規作成・閲覧・編集をこの1枚で行う)。show_panel.jsが担当、新規保存だけ memo_saving.js
    外側(#main_show_panel)は画面全体を薄暗くぼかす幕、内側(.show_panel)が真ん中に出るメモの画面。
    「編集の状態」の時だけ、#main_show_panel に editing クラスが付き、表示用の文字の代わりに入力欄が見える %>
<div id="main_show_panel">
  <div class="show_panel">
    <div class="buttons_header">
      <div class="date"></div>
      <%# タイトルは日付の右隣に置く。閲覧の状態では文字(.show_title)、編集の状態では入力欄(#title)が、同じ位置に出る
          入力欄は form の外にあるが、form="memo_form" で下のフォームの一部として扱わせる(Enterで送信されないようにする処理を、本文欄と同じフォームでまとめて効かせるため) %>
      <div class="show_title"></div>
      <input type="text" id="title" name="title" placeholder="タイトル" class="input_form" form="memo_form">
      <div class="button_group">
        <div class="edit_button">編集</div>
        <button type="button" id="save_btn">保存</button>
        <div class="close_button">閉じる</div>
      </div>
    </div>
    <%# 閲覧の状態で見える、本文の表示 %>
    <div class="show_content">
      <div class="body"></div>
    </div>
    <%# 編集の状態で見える、本文の入力欄 %>
    <form class="panel-form" id="memo_form">
      <textarea id="body" name="body" placeholder="思考する" class="textarea_form"></textarea>
    </form>
  </div>
</div>

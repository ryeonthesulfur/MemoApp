<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Memo App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Memo App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# ページを移る時、Turboが覚えている前回の画面(見出しやパネルが表示済み)を先に一瞬見せないようにする。見せるとブリンクしてからフワッと出てしまうため %>
    <meta name="turbo-cache-control" content="no-preview">

    <%= yield :head %>

    <%# 背景をビジュアライザーにしているかを、画面を描く前に決めておく(background.js と同じ判定)。
        描いた後に決めると、背景画像が一瞬見えてから消えてしまうため %>
    <script>
      try { if (localStorage.getItem('background') !== 'image') document.documentElement.classList.add('ambient'); }
      catch (e) { document.documentElement.classList.add('ambient'); }
    </script>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@200..900&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <%# 背景のビジュアライザーを描く場所(background.js が描く)。ページを移っても取り替えないので、途切れずに動き続ける %>
  <canvas id="ambient_canvas" data-turbo-permanent aria-hidden="true"></canvas>
  <%# 背景画像は、CSS(application.css)の側で付けるので、ここでは場所だけ渡す(画像の場所は、Railsでないと決められないため) %>
  <div class="background" style="--background-image: url('<%= asset_path('background_image.jpg') %>');">
    <div class="content">
      <div class="side_bar">
        <div></div>
        <ul class="main-box">
          <li class="item-boxes"><%= link_to "憶", memory_path %></li>
          <li class="item-boxes">時</li>
          <li class="item-boxes"><%= link_to "音", sound_path %></li>
          <%# 背景を「ビジュアライザー」と「背景画像」で切り替えるボタン(background.js) %>
          <li class="item-background" title="背景を切り替える"><span class="material-symbols-outlined">wallpaper</span></li>
          <li class="item-close"><span class="material-symbols-outlined">power_settings_new</span></li>
        </ul>
      </div>

      <div class="main_content">
        <div class="right_header">
          <h1 id="header_title">記憶</h1>
          <h1 id="header_title">カレンダー</h1>
          <ul class="header_links">
            <li><a href="https://www.youtube.com/" target="_blank"><img src="https://www.google.com/s2/favicons?domain=youtube.com&sz=128" /></a></li>
            <li><a href="https://gemini.google.com/" target="_blank"><img src="https://www.google.com/s2/favicons?domain=gemini.google.com&sz=128" /></a></li>
            <li><a href="https://claude.ai/" target="_blank"><img src="https://www.google.com/s2/favicons?domain=claude.ai&sz=128" /></a></li>
            <li><a href="https://www.amazon.co.jp/" target="_blank"><img src="https://www.amazon.co.jp/favicon.ico" /></a></li>
            <li><a href="https://x.com/" target="_blank"><img src="https://x.com/favicon.ico" /></a></li>
            <li><a href="https://www.instagram.com/" target="_blank"><img src="https://www.google.com/s2/favicons?domain=instagram.com&sz=128" /></a></li>
            <li><a href="https://www.netflix.com/" target="_blank"><img src="https://www.netflix.com/favicon.ico" /></a></li>
          </ul>
        </div>
        <div class="main_title" id="main_title" data-turbo-permanent>MIND PALACE</div>
        <%# Webampのウィンドウを入れる場所。ページを移っても取り替えないので、ウィンドウの状態や位置がそのまま残る(「音」以外のページではCSSで隠す) %>
        <div id="webamp_container" data-turbo-permanent></div>
        <%= yield %>
      </div>
      </div>
    </div>
  </body>
</html>
